# =========================  copy this file to .env and edit  =========================
# Public address of the site (used in sitemap.xml / robots.txt)
PUBLIC_URL=https://tehreer.com
# Only for the Caddy setup (docker-compose.yml): the domain Caddy gets a certificate for
DOMAIN=tehreer.com
BRAND=Tehreer

# ---- security (CHANGE THESE) ----
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DB_ROOT_PASSWORD=change-this-root-password
DB_PASSWORD=change-this-db-password
# NOTE: MySQL stores these when its data volume is first created; changing them later in
# this file does not change the existing database users.

# ---- phpMyAdmin (database dashboard), reachable at http://127.0.0.1:PMA_PORT on the server ----
PMA_PORT=8081

# ---- e-mail that delivers the verification / password-reset codes ----
# Gmail: use a dedicated Gmail account with 2-Step Verification and an "App password"
# (https://myaccount.google.com/apppasswords). Any SMTP provider works (Brevo, SES, Mailgun ...).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourapp@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=yourapp@gmail.com
# Local testing without SMTP: set SMTP_HOST empty and ALLOW_DEV_CODES=1; the code is printed in
# `docker compose logs app`. NEVER enable this on a public server.
ALLOW_DEV_CODES=0
# Who may sign in (comma separated; empty = any e-mail address)
ALLOWED_EMAIL_DOMAINS=gmail.com,googlemail.com

# ---- "Continue with Google" button ----
# Google Cloud Console > APIs & Services > Credentials > Create credentials > OAuth client ID > Web application.
# Under "Authorized redirect URIs" add:  http://localhost:6550/api/auth/google/callback
#                                   and:  https://tehreer.com/api/auth/google/callback   (your real domain)
# Paste the Client ID and Client secret here. Leave empty to show the button but report "not set up".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: force the exact redirect address (normally it is worked out from the address you open the site with)
GOOGLE_REDIRECT_URI=

# ---- passwords ----
PASSWORD_MIN_LENGTH=10
MAX_LOGIN_FAILURES=5
LOCK_MINUTES=15

# ---- limits (optional) ----
MAX_CONCURRENT_JOBS=2
MAX_ACTIVE_PER_USER=1
MAX_JOBS_PER_DAY_PER_USER=20
JOB_TTL_HOURS=24
MAX_JOB_MINUTES=180
